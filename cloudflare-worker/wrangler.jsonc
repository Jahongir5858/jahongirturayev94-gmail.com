{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-mtproto-stream-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_HOSTS": "fayllar1.ru,*.fayllar1.ru",
    "ORIGIN_REFERER": "https://asilmedia.org/",
    "ORIGIN_USER_AGENT": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/152 Safari/537.36"
  }
}
